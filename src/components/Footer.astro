---
// src/components/Footer.astro
import { SITE, NAV } from '../data/site.js';

const redes = [
  { nombre: 'Instagram', url: SITE.instagram, icono: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>' },
  { nombre: 'Facebook', url: SITE.facebook, icono: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
  { nombre: 'YouTube', url: SITE.youtube, icono: '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>' },
  { nombre: 'LinkedIn', url: SITE.linkedin, icono: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>' },
].filter((r) => r.url);
---
<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="logo"><img class="logo__img" src="/logo-on.svg" alt="ON" width="53" height="36" /><span class="logo__sub">Marketing<br />Digital</span></p>
      <p class="muted">{SITE.tagline}</p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="footer__links">
        {NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/privacidad">Privacidad</a></li>
      </ul>
    </nav>
    {redes.length > 0 && (
      <div class="footer__socials">
        {redes.map((r) => (
          <a class="footer__social" href={r.url} target="_blank" rel="noopener" aria-label={`${r.nombre} de ON Marketing Digital`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icono} />
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="container footer__bar">
    <p class="footer__copy">© 2026 {SITE.name}. Todos los derechos reservados.</p>
    <p class="footer__copy">{SITE.zona}</p>
  </div>
</footer>