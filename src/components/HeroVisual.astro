---
// src/components/HeroVisual.astro
// Para reemplazar por una imagen: borrá el <svg> y poné
// <img src="/hero.webp" alt="Botón de encendido verde brillante, símbolo de ON Marketing Digital" width="520" height="520" loading="eager" />
---
<div class="hero-visual">
  <img src="/hero.webp" alt="Botón de encendido verde brillante, símbolo de ON Marketing Digital" width="1376" height="768" loading="eager" />
</div>
  <svg viewBox="0 0 200 200" width="420" height="420">
    <defs>
      <linearGradient id="pw" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#B8FF4A" /><stop offset="1" stop-color="#19E6A0" />
      </linearGradient>
      <filter id="blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
    </defs>
    <circle cx="100" cy="100" r="88" fill="none" stroke="#1F2B25" stroke-width="1" />
    <circle cx="100" cy="100" r="70" fill="none" stroke="#1F2B25" stroke-width="1" stroke-dasharray="2 6" />
    <g filter="url(#blur)" opacity=".8">
      <path d="M68 62a50 50 0 1 0 64 0" fill="none" stroke="url(#pw)" stroke-width="12" stroke-linecap="round" />
      <path d="M100 40v56" stroke="url(#pw)" stroke-width="12" stroke-linecap="round" />
    </g>
    <path d="M68 62a50 50 0 1 0 64 0" fill="none" stroke="url(#pw)" stroke-width="10" stroke-linecap="round" />
    <path d="M100 40v56" stroke="url(#pw)" stroke-width="10" stroke-linecap="round" />
  </svg>
</div>
