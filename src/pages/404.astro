---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="La página que buscás no existe." path="/404" noindex>
  <section class="hero hero--page">
    <div class="container container--narrow">
      <p class="eyebrow">ERROR 404</p>
      <h1>Esta página no <span class="grad">existe</span>.</h1>
      <p class="lead">Puede que el enlace esté mal o que la hayamos movido.</p>
      <a class="btn btn--primary" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>
